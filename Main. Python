# This is the 2nd file that uses the 1st file (student_manager.py)
from student_manager import DATA_FILE, Student, add_student
import json
import os

class FileNotFoundException(Exception):
    pass

def read_student_data():
    """Read Student Data from file"""
    try:
        if not os.path.exists(DATA_FILE):
            raise FileNotFoundException(f"Data file '{DATA_FILE}' not found. Please add a student first.")

        with open(DATA_FILE, 'r') as f:
            data = json.load(f)

        if not data:
            print("No student records found.")
            return

        print("\n--- Student Records ---")
        print(f"{'Roll No':<10} {'Name':<20} {'Email':<30} {'Course':<15}")
        print("-"*75)
        for s in data:
            print(f"{s['roll_no']:<10} {s['name']:<20} {s['email']:<30} {s['course']:<15}")

    except FileNotFoundException as e:
        print(f"[Error] {e}")
    except json.JSONDecodeError:
        print("[Error] Data file is corrupted or empty.")
    except Exception as e:
        print(f"[Error] Failed to read data: {e}")

def main_menu():
    while True:
        try:
            print("\n====== Student Record Manager ======")
            print("1. Add Student (uses File 1)")
            print("2. Read Student Data (uses File 2)")
            print("3. Exit")
            choice = input("Enter your choice (1-3): ").strip()

            if choice == '1':
                add_student()
            elif choice == '2':
                read_student_data()
            elif choice == '3':
                print("Exiting... Goodbye!")
                break
            else:
                raise ValueError("Invalid choice! Please enter 1, 2 or 3.")

        except ValueError as ve:
            print(f"[Invalid Input Exception] {ve}")
        except Exception as e:
            print(f"[Exception] {e}")

if __name__ == "__main__":
    main_menu()
